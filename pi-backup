# ============================================================================
#  pi-backup help / version
# ============================================================================
cmd_help() {
  cat <<EOF
🍓 pi-backup v$VERSION — one-command backup & restore for Raspberry Pi

USAGE
  pi-backup COMMAND [args]

SETUP
  wizard                  Interactive configuration (7 quick questions)
  schedule install|show|remove
  config show|set KEY VALUE|edit

EVERY DAY
  backup [-q|-v]          Create a backup now (safe on a live system)
  list [--json]           Show backups in the destination
  verify [name|latest|all]
  delete [name]           Delete a backup (+ sidecars)
  status                  One-screen health dashboard
  doctor                  Preflight checks with human fixes

WHEN THINGS GO WRONG
  restore [name]          Restore from an archive (interactive)
  restore --target DIR    Extract full archive into a directory (system untouched)
  restore --paths LIST    Restore selected paths onto / (e.g. etc/nginx)
  restore --packages      Reinstall packages from a saved package list
  restore --what? -> help Restore flags: --everything --force --dry-run
                                 --no-verify --no-snapshot --latest --yes

HOUSEKEEPING
  uninstall [--purge]     Uninstall (backups are NEVER touched)
  update                  Update pi-backup itself from GitHub

EXAMPLES
  sudo pi-backup backup
  sudo pi-backup list
  sudo pi-backup restore latest --target /mnt/recovered
  sudo pi-backup restore pi-backup-20260101-020000 --paths etc/nginx,home/keshav
  sudo pi-backup verify all

Exit codes: 0 ok · 2 usage · 3 lock/busy · 4 config · 5 space · 6 tar · 7 verify
Docs: https://github.com/keshavsapra/pi-backup
EOF
}

cmd_version() { printf 'pi-backup %s\n' "$VERSION"; }

# ============================================================================
#  main — parse global flags anywhere on the line, dispatch the subcommand
# ============================================================================
main() {
  local a seen_sub=0
  for a in "$@"; do
    if (( ! seen_sub )); then
      case "$a" in
        -q|--quiet)     QUIET=1 ;;
        -v|--verbose)   VERBOSE=1 ;;
        -y|--yes)       ASSUME_YES=1 ;;
        -h|--help)      SUB="help"; seen_sub=1 ;;
        -V|--version)   SUB="version"; seen_sub=1 ;;
        -*)             usage_err "unknown option \"$a\"";;
        *)              SUB="$a"; seen_sub=1 ;;
      esac
    else
      case "$a" in
        -q|--quiet)   QUIET=1 ;;
        -v|--verbose) VERBOSE=1 ;;
        -y|--yes)     ASSUME_YES=1 ;;
        -h|--help)    SUB="help" ;;
        -V|--version) cmd_version; exit 0 ;;
        *)            REST+=("$a") ;;
      esac
    fi
  done

  case "$SUB" in
    help)    cmd_help ;;
    version) cmd_version ;;
    wizard)  cmd_wizard ;;
    backup)  cmd_backup ;;
    list)    cmd_list ;;
    verify)  cmd_verify ;;
    restore) cmd_restore "${REST[@]+"${REST[@]}"}" ;;
    delete)  cmd_delete "${REST[@]+"${REST[@]}"}" ;;
    status)  cmd_status ;;
    doctor)  cmd_doctor ;;
    config)  cmd_config ;;
    schedule) cmd_schedule ;;
    uninstall) cmd_uninstall ;;
    update)  cmd_update ;;
    "")
      if [[ -r "$CONF_FILE" ]]; then
        cmd_help
      else
        cmd_help
        echo ""
        hint "First time? Run the wizard:  ${C_B}sudo pi-backup wizard${C_0}"
      fi
      ;;
    *) usage_err "unknown command: $SUB" ;;
  esac
}

main "$@"


